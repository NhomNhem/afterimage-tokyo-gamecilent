<?xml version="1.0" encoding="utf-8"?>
<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/_Project/Code/Bootstrap/Editor/GameplayLifetimeScopeEditor.uss?fileID=7433441132597879392&amp;guid=819da399884662a43b935320bd51ec2f&amp;type=3#GameplayLifetimeScopeEditor"/>
    <engine:VisualElement name="container" class="main-container">

        <engine:VisualElement name="header" class="header">
            <engine:Label name="title" text="Gameplay Lifetime Scope" class="title"/>
            <engine:Label name="subtitle" text="M0 Gameplay Composition Root" class="subtitle"/>
        </engine:VisualElement>

        <engine:VisualElement name="content" class="content">

            <engine:VisualElement name="core-adapters" class="section">
                <engine:VisualElement class="section-header">
                    <engine:Label text="CORE ADAPTERS" class="section-title"/>
                    <engine:VisualElement class="divider"/>
                </engine:VisualElement>
                <engine:VisualElement class="section-content">
                    <editor:PropertyField binding-path="tickHandler" label="Tick Handler"/>
                    <editor:PropertyField binding-path="targetableAdapter" label="Targetable Adapter"/>
                    <editor:PropertyField binding-path="loopDriver" label="Enemy Intent Loop Driver"/>
                    <editor:PropertyField binding-path="playerInput" label="Direct Player Input"/>
                    <editor:PropertyField binding-path="visualFeedbackAdapter" label="Combat Visual Feedback"/>
                    <editor:PropertyField binding-path="debugOverlayAdapter" label="Debug Overlay Adapter"/>
                    <editor:PropertyField binding-path="animationPresentationAdapter" label="Animation Presentation Adapter"/>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="animation-drivers" class="section">
                <engine:VisualElement class="section-header">
                    <engine:Label text="ANIMATION DRIVERS" class="section-title"/>
                    <engine:VisualElement class="divider"/>
                </engine:VisualElement>
                <engine:VisualElement class="section-content">
                    <editor:PropertyField binding-path="playerAnimationDriver" label="Player Animation Driver"/>
                    <editor:PropertyField binding-path="enemyAnimationDriver" label="Enemy Animation Driver"/>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="configs" class="section">
                <engine:VisualElement class="section-header">
                    <engine:Label text="CONFIGS" class="section-title"/>
                    <engine:VisualElement class="divider"/>
                </engine:VisualElement>
                <engine:VisualElement class="section-content">
                    <editor:PropertyField binding-path="combatTimingConfig" label="Combat Timing Config"/>
                    <editor:PropertyField binding-path="locomotionConfig" label="Locomotion Config"/>
                    <editor:PropertyField binding-path="memoryRuntimeTuningConfig" label="Memory Runtime Tuning Config"/>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="memory-system" class="section">
                <engine:VisualElement class="section-header">
                    <engine:Label text="MEMORY SYSTEM" class="section-title"/>
                    <engine:VisualElement class="divider"/>
                </engine:VisualElement>
                <engine:VisualElement class="section-content">
                    <editor:PropertyField binding-path="memoryProbe" label="Memory Raycast Probe"/>
                    <editor:PropertyField binding-path="memoryFragments" label="Memory Fragments"/>
                </engine:VisualElement>
            </engine:VisualElement>

            <engine:VisualElement name="vcontainer-section" class="section vcontainer-section">
                <engine:Foldout name="vcontainer-foldout" text="VCONTAINER SETTINGS" value="false">
                    </engine:Foldout>
            </engine:VisualElement>

        </engine:VisualElement>

        <engine:VisualElement name="footer" class="footer">
            <engine:Label name="footer-text" text="Manual VContainer composition for M0 Gameplay" class="footer-text"/>
        </engine:VisualElement>

    </engine:VisualElement>
</engine:UXML>
