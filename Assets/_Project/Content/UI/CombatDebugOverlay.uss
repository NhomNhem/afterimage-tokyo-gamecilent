.debug-container {
    position: absolute;
    top: 10px;
    left: 10px;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 10px;
    border-radius: 5px;
    width: 250px;
}

.debug-label {
    font-size: 12px;
    color: #00ff00;
    margin-bottom: 5px;
    unity-font-style: bold;
}

.interaction-prompt {
    position: absolute;
    bottom: 72px;
    align-self: center;
    padding: 8px 12px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.72);
}

.interaction-prompt-label {
    font-size: 16px;
    color: #ffffff;
    unity-font-style: bold;
}

.hidden {
    display: none;
}
