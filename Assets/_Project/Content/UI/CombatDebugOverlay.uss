.debug-container {
    position: absolute;
    top: 10px;
    left: 10px;
    flex-direction: column;
    background-color: rgba(0, 0, 0, 0.7);
    padding: 10px;
    border-radius: 5px;
    width: 250px;
}

.debug-label {
    font-size: 12px;
    color: #00ff00;
    margin-bottom: 5px;
    unity-font-style: bold;
}

.interaction-prompt {
    position: absolute;
    bottom: 72px;
    align-self: center;
    padding: 8px 12px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.72);
}

.interaction-prompt-label {
    font-size: 16px;
    color: #ffffff;
    unity-font-style: bold;
}

.memory-reveal-feedback {
    position: absolute;
    bottom: 118px;
    align-self: center;
    padding: 10px 14px;
    border-radius: 5px;
    background-color: rgba(18, 12, 30, 0.78);
    border-left-width: 3px;
    border-left-color: #8fe6ff;
}

.memory-reveal-feedback-label {
    font-size: 16px;
    color: #dff7ff;
    unity-font-style: bold;
}

.runtime-memory-log {
    position: absolute;
    top: 10px;
    right: 10px;
    width: 250px;
    flex-direction: column;
    padding: 8px 10px;
    border-radius: 5px;
    background-color: rgba(0, 0, 0, 0.72);
    border-left-width: 3px;
    border-left-color: #9cffb7;
}

.runtime-memory-log-title {
    font-size: 11px;
    color: #9cffb7;
    unity-font-style: bold;
    margin-bottom: 4px;
}

.runtime-memory-log-entry {
    font-size: 13px;
    color: #ffffff;
    unity-font-style: bold;
}

.hidden {
    display: none;
}
